# ============================================
# 小苏 - 公司内部 AI 助手 - Docker Compose 环境变量
# ============================================
# 复制此文件为项目根目录下的 .env 并修改：
#   cp .env.example .env
# docker-compose.yml 会自动读取本文件

# MySQL root 密码（首次初始化写入 volume，后续修改需重建 volume 才生效）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# MySQL 数据库名
MYSQL_DATABASE=rag_knowledge_base

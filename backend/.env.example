# ============================================
# 小苏 - 公司内部 AI 助手 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env

# ---------- 应用 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=小苏 - 公司内部 AI 助手

# ---------- 数据库 (MySQL 8.0) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=rag_knowledge_base

# ---------- JWT 认证 ----------
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- LLM / Embedding 提供商 ----------
# "ollama" = 本地 Ollama（免费，需安装 Ollama + 模型）
# "openai" = 云端 OpenAI 兼容 API（MiniMax / DeepSeek / SiliconFlow / OpenAI）
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama 本地配置 ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:1.5b
EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI 兼容 API 配置（LLM_PROVIDER=openai 时生效） ---
# MiniMax:   https://api.minimax.chat/v1  |  模型: MiniMax-Text-01
# DeepSeek:  https://api.deepseek.com/v1  |  模型: deepseek-chat
# SiliconFlow: https://api.siliconflow.cn/v1 |  模型: Qwen/Qwen2.5-7B-Instruct
# OpenAI:    https://api.openai.com/v1    |  模型: gpt-4o
OPENAI_BASE_URL=https://api.minimax.chat/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_LLM_MODEL=MiniMax-Text-01

# --- OpenAI 兼容 Embedding（EMBEDDING_PROVIDER=openai 时生效） ---
# ⚠️ 切换 Embedding 模型后需重建知识库向量（维度不同，旧向量不兼容）
# OPENAI_EMBEDDING_MODEL=embo-01

# ---------- ChromaDB 向量数据库 ----------
CHROMA_PERSIST_DIR=../data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_chunks

# ---------- Redis 缓存 ----------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_CACHE_ENABLED=True

# ---------- 文件上传 ----------
UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE_MB=50

# ============================================
# 小苏 - 公司内部 AI 助手 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env

# ---------- 应用 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=小苏 - 公司内部 AI 助手

# ---------- 数据库 (MySQL 8.0) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=rag_knowledge_base

# ---------- JWT 认证 ----------
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 管理员白名单（逗号分隔用户名，与 users.is_admin 字段满足其一即管理员）
ADMIN_USERNAMES=

# ---------- LLM / Embedding 提供商 ----------
# "ollama" = 本地 Ollama（免费，需安装 Ollama + 模型）
# "openai" = 云端 OpenAI 兼容 API（MiniMax / DeepSeek / SiliconFlow / OpenAI）
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama 本地配置 ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:1.5b
EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI 兼容 API 配置（LLM_PROVIDER=openai 时生效） ---
# MiniMax:   https://api.minimax.chat/v1  |  模型: MiniMax-Text-01
# DeepSeek:  https://api.deepseek.com/v1  |  模型: deepseek-chat
# SiliconFlow: https://api.siliconflow.cn/v1 |  模型: Qwen/Qwen2.5-7B-Instruct
# OpenAI:    https://api.openai.com/v1    |  模型: gpt-4o
OPENAI_BASE_URL=https://api.minimax.chat/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_LLM_MODEL=MiniMax-Text-01

# --- OpenAI 兼容 Embedding（EMBEDDING_PROVIDER=openai 时生效） ---
# ⚠️ 切换 Embedding 模型后需重建知识库向量（维度不同，旧向量不兼容）
# OPENAI_EMBEDDING_MODEL=embo-01

# ---------- ChromaDB 向量数据库 ----------
CHROMA_PERSIST_DIR=../data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_chunks

# ---------- Redis 缓存 ----------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_CACHE_ENABLED=True

# ---------- RAG 问答 ----------
# 拒答硬阈值：精排后 top1 相关度低于该值时不调用 LLM，直接返回拒答文案
REFUSAL_SCORE_THRESHOLD=0.35

# ---------- Agent 工具调用（Phase 3） ----------
AGENT_MAX_ROUNDS=5
MOCK_API_BASE=http://127.0.0.1:8000

# ---------- 飞书机器人（Phase 4） ----------
# 在飞书开放平台 https://open.feishu.cn 创建"企业自建应用"并开通机器人能力后获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here
# 事件订阅的 Encrypt Key / Verification Token（长连接模式可留空）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# 机器人默认查询的知识库 ID（0 = 自动选第一个知识库）
FEISHU_DEFAULT_KB_ID=0
# 消息幂等去重窗口（秒）
BOT_IDEMPOTENCY_TTL=300

# ---------- 文件上传 ----------
UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE_MB=50

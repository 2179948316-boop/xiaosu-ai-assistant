# ============================================
# 小苏 - 公司内部 AI 助手 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env

# ---------- 应用 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=小苏 - 公司内部 AI 助手

# ---------- 数据库 (MySQL 8.0) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=rag_knowledge_base

# ---------- JWT 认证 ----------
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 管理员白名单（逗号分隔用户名，与 users.is_admin 字段满足其一即管理员）
ADMIN_USERNAMES=

# ===== LLM 提供商 =====
# "minimax" = MiniMax 云端（默认）
# "deepseek" = DeepSeek 云端
LLM_PROVIDER=minimax

# --- MiniMax 配置 ---
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_LLM_MODEL=MiniMax-Text-01

# --- DeepSeek 配置 ---
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_LLM_MODEL=deepseek-chat

# --- Embedding 配置（始终走 MiniMax） ---
# ⚠️ 切换 Embedding 模型后需重建知识库向量（维度不同，旧向量不兼容）
EMBEDDING_BASE_URL=https://api.minimax.chat/v1
EMBEDDING_API_KEY=your-minimax-api-key-here
EMBEDDING_MODEL=embo-01

# ---------- ChromaDB 向量数据库 ----------
CHROMA_PERSIST_DIR=../data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_chunks

# ---------- Redis 缓存 ----------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_CACHE_ENABLED=True

# ---------- RAG 问答 ----------
# 拒答硬阈值：精排后 top1 相关度低于该值时不调用 LLM，直接返回拒答文案
REFUSAL_SCORE_THRESHOLD=0.35

# ---------- Agent 工具调用（Phase 3） ----------
AGENT_MAX_ROUNDS=5
MOCK_API_BASE=http://127.0.0.1:8000

# ---------- 飞书机器人（Phase 4） ----------
# 在飞书开放平台 https://open.feishu.cn 创建"企业自建应用"并开通机器人能力后获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here
# 事件订阅的 Encrypt Key / Verification Token（长连接模式可留空）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# 机器人默认查询的知识库 ID（0 = 自动选第一个知识库）
FEISHU_DEFAULT_KB_ID=0
# 消息幂等去重窗口（秒）
BOT_IDEMPOTENCY_TTL=300

# ---------- 文件上传 ----------
UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE_MB=50
